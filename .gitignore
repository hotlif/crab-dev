.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
node_modules

# The project-local cache stays machine-local. To use zero-installs instead,
# unignore and commit `.yarn/cache` together with the generated PnP runtime.
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

.pnp.*
!.pnp.cjs
!.pnp.loader.mjs
.out
declarations
esm
cjs
css
coverage
.tmp
/.tmp-*.log
dist
.cache
trivy.report.txt

.turbo
**/.wake/


.nx/polygraph

# Keep review notes, indexes, input fingerprints, logs and referenced PNG evidence.
# Archive full Playwright reports and raw run output separately from Git.
/.website/review/**/report/
/.website/review/**/playwright-report/
/.website/review/**/blob-report/
/.website/review/**/test-results/
/.website/review/**/results.json

# Browser recordings, traces and local profiles are not curated review evidence.
/.website/review/**/*.webm
/.website/review/**/*.mp4
/.website/review/**/trace/
/.website/review/**/trace.zip
/.website/review/**/.playwright-artifacts-*/
/.website/review/**/profile/
/.website/review/**/browser-profile/
