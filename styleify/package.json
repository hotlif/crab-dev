{
    "name": "@crab/styleify",
    "description": "通过提供预设的 CSS 变量、简化的类名和跨浏览器兼容性支持，优化了开发流程并提高了开发效率。",
    "packageManager": "yarn@4.7.0",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "build": "packify build",
        "pack:tgz": "yarn pack --out .out/%s-%v.tgz",
        "eslint": "eslint"
    },
    "main": "esm/index.mjs",
    "module": "esm/index.mjs",
    "types": "esm/index.d.ts",
    "files": [
        "esm"
    ],
    "devDependencies": {
        "@crab/packify": "workspace:^",
        "@crab/standards-eslint-preset": "workspace:^",
        "@crab/standards-typescript-preset": "workspace:^",
        "@types/node": "^22.13.10",
        "@types/react": "^19.0.11",
        "@types/react-dom": "^19.0.4",
        "eslint": "^9.22.0",
        "eslint-plugin-react": "^7.37.4",
        "globals": "^16.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router": "^7.3.0",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.1"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1"
    },
    "engines": {
        "node": ">=22"
    }
}
