{
    "name": "@crab-dev/styleify",
    "description": "通过提供预设的 CSS 变量、简化的类名和跨浏览器兼容性支持，优化了开发流程并提高了开发效率。",
    "packageManager": "yarn@4.7.0",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "build:library": "packify build",
        "test": "yarn node --experimental-vm-modules $(yarn bin jest)",
        "eslint": "eslint"
    },
    "files": [
        "esm",
        "cjs",
        "declarations"
    ],
    "bin": "bin/cli.js",
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "devDependencies": {
        "@crab-dev/packify": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-jest-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@types/node": "^25.3.5",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.0.3",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.4.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "30.2.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router": "^7.13.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1"
    },
    "engines": {
        "node": ">=22"
    }
}
