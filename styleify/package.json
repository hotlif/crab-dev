{
    "name": "@crab/styleify",
    "description": "通过提供预设的 CSS 变量、简化的类名和跨浏览器兼容性支持，优化了开发流程并提高了开发效率。",
    "packageManager": "yarn@4.7.0",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "build:library": "packify build",
        "pack:tgz": "yarn pack --out .out/%s-%v.tgz",
        "eslint": "eslint"
    },
    "files": [
        "esm",
        "cjs",
        "declarations"
    ],
    "bin": "bin/cli.js",
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "devDependencies": {
        "@crab/packify": "workspace:^",
        "@crab/standards-eslint-preset": "workspace:^",
        "@crab/standards-typescript-preset": "workspace:^",
        "@types/node": "^22.15.30",
        "@types/react": "^19.1.6",
        "@types/react-dom": "^19.1.6",
        "eslint": "^9.28.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^16.2.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router": "^7.6.2",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.33.1"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1"
    },
    "engines": {
        "node": ">=22"
    }
}
