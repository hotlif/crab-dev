{
  "name": "@crab-dev/rc-tree",
  "websiteConfig": {
    "title": "Tree 树形控件",
    "category": "navigation"
  },
  "description": "一个多功能且可定制的树形组件, 用于React应用程序, 提供高效的渲染和拖放功能。",
  "packageManager": "yarn@4.16.0",
  "version": "0.1.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/hotlif/crab-dev.git",
    "directory": "components/rc-tree"
  },
  "type": "module",
  "scripts": {
    "start": "yarn generate:token && lignify run-task app:dev",
    "build:library": "packify build",
    "generate:token": "packify generate:css-token",
    "test": "packify test",
    "eslint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "esm",
    "cjs",
    "css",
    "declarations"
  ],
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "import": "./esm/index.mjs",
      "require": "./cjs/index.cjs"
    },
    "./css/index.css": "./css/index.css",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@crab-dev/lignify": "workspace:^",
    "@crab-dev/packify": "workspace:^",
    "@crab-dev/rc-component-preview": "workspace:^",
    "@crab-dev/rc-masonry": "workspace:^",
    "@crab-dev/rc-menu": "workspace:^",
    "@crab-dev/rc-token-semantic": "workspace:^",
    "@crab-dev/standards-eslint-preset": "workspace:^",
    "@crab-dev/standards-jest-preset": "workspace:^",
    "@crab-dev/standards-typescript-preset": "workspace:^",
    "@jest/globals": "30.4.1",
    "@linaria/core": "^8.0.0",
    "@mdx-js/react": "^3.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@crab-dev/rc-checkbox": "workspace:^",
    "@crab-dev/rc-hooks": "workspace:^",
    "@crab-dev/rc-spin": "workspace:^",
    "@crab-dev/rc-virtual": "workspace:^",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "decimal.js": "^10.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
