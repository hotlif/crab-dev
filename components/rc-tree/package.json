{
    "name": "@crab-dev/rc-tree",
    "description": "一个多功能且可定制的树形组件, 用于React应用程序, 提供高效的渲染和拖放功能。",
    "packageManager": "yarn@4.18.0",
    "version": "0.2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-tree"
    },
    "type": "module",
    "scripts": {
        "start": "yarn generate:token && yarn generate:docgen && wake docs dev . --mode components",
        "build:library": "yarn generate:token && wake library build .",
        "generate:docgen": "wake library docgen .",
        "generate:token": "wake library token .",
        "test": "wake test --serial --coverage",
        "test:browser": "yarn build:library && node scripts/prepare-browser-tests.mjs && yarn test --root src/__tests__/browser",
        "typecheck": "tsc --noEmit",
        "lint": "wake lint --format human --root ../.. components/rc-tree/src components/rc-tree/docs --env browser --max-warnings 0 && yarn lint:tools",
        "lint:tools": "wake lint --format human --root ../.. components/rc-tree/scripts --env node --max-warnings 0",
        "check": "node ../../scripts/check-package.mjs",
        "test:custom-editor": "yarn test --root src/__tests__/custom-editor-browser",
        "test:forced-colors": "yarn --cwd ../.. exec turbo run build:library --filter=@crab-dev/rc-tree && node ../../scripts/prepare-published-css.mjs && node ../../scripts/test-published-forced-colors.mjs --package=. --fixture=src/__tests__/browser/forced-colors-fixture.tsx --api=__treeForced",
        "build:visual": "wake docs build . --mode components --outdir .cache/visual-workbench",
        "test:visual": "node ../../scripts/visual/run.mjs --package ."
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./css/index.css": "./css/index.css",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@crab-dev/rc-auto-sizer": "workspace:^",
        "@crab-dev/rc-button": "workspace:^",
        "@crab-dev/rc-theme": "workspace:^",
        "@crab-dev/rc-token-semantic": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.45",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router": "^8.3.1",
        "typescript": "6.0.2"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.45",
        "@crab-dev/rc-checkbox": "workspace:^",
        "@crab-dev/rc-config-provider": "workspace:^",
        "@crab-dev/rc-hooks": "workspace:^",
        "@crab-dev/rc-line-edit": "workspace:^",
        "@crab-dev/rc-spin": "workspace:^",
        "@crab-dev/rc-virtual": "workspace:^",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "decimal.js": "^10.6.0"
    },
    "engines": {
        "node": ">=22"
    },
    "crab": {
        "requiredChecks": [
            "test:browser",
            "test:custom-editor",
            "test:forced-colors"
        ],
        "docsDependencies": [
            "@crab-dev/rc-auto-sizer",
            "@crab-dev/rc-button"
        ]
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    }
}
