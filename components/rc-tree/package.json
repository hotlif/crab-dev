        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@jest/globals": "30.1.2",
        "@linaria/core": "^6.3.0",
        "@types/node": "^24.4.0",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
