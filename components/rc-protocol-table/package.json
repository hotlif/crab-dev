{
    "name": "@crab-dev/rc-protocol-table",
    "websiteConfig": {
        "title": "高阶 Table 表格",
        "category": "data-display"
    },
    "description": "高效的协议表格库，旨在提升大规模列表或内容渲染的性能。",
    "packageManager": "yarn@4.16.0",
    "version": "0.1.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-protocol-table"
    },
    "type": "module",
    "scripts": {
        "start": "yarn generate:docgen && lignify run-task app:dev",
        "build:library": "packify build",
        "generate:docgen": "packify generate:docgen",
        "test": "packify test --passWithNoTests",
        "eslint": "eslint --fix",
        "prepack": "cd ../.. && yarn build:library",
        "typecheck": "tsc --noEmit"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "devDependencies": {
        "@crab-dev/lignify": "workspace:^",
        "@crab-dev/packify": "workspace:^",
        "@crab-dev/rc-component-preview": "workspace:^",
        "@crab-dev/rc-masonry": "workspace:^",
        "@crab-dev/rc-menu": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-jest-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@jest/globals": "^30.4.1",
        "@linaria/core": "^8.0.0",
        "@mdx-js/react": "^3.1.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.6.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.7.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "30.4.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router": "^8.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0"
    },
    "dependencies": {
        "@crab-dev/rc-auto-sizer": "workspace:^",
        "@crab-dev/rc-checkbox": "workspace:^",
        "@crab-dev/rc-date-picker": "workspace:^",
        "@crab-dev/rc-line-edit": "workspace:^",
        "@crab-dev/rc-pagination": "workspace:^",
        "@crab-dev/rc-spin": "workspace:^",
        "@crab-dev/rc-table": "workspace:^",
        "@crab-dev/rc-tree": "workspace:^"
    },
    "engines": {
        "node": ">=22"
    }
}
