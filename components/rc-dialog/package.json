{
    "name": "@crab-dev/rc-dialog",
    "description": "A dialog component for React applications.",
    "packageManager": "yarn@4.7.0",
    "type": "module",
    "scripts": {
        "start": "yarn generate:docgen && yarn generate:token && lignify run-task app:dev",
        "build:library": "packify build",
        "generate:docgen": "react-docgen ./src/dialog.tsx --out ./public/docgen.json",
        "generate:token": "packify generate:css-token",
        "test": "yarn node --experimental-vm-modules $(yarn bin jest)",
        "eslint": "eslint"
    },
    "files": [
        "esm",
        "cjs",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "dependencies": {
        "@crab-dev/rc-button": "workspace:^",
        "motion": "^12.35.1"
    },
    "devDependencies": {
        "@crab-dev/lignify": "workspace:^",
        "@crab-dev/packify": "workspace:^",
        "@crab-dev/rc-menu": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-jest-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@jest/globals": "30.2.0",
        "@linaria/core": "^7.0.0",
        "@mdx-js/react": "^3.1.1",
        "@react-docgen/cli": "^3.0.5",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.3.5",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.0.3",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.4.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "30.2.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-icons": "^5.6.0",
        "react-markdown": "^10.1.0",
        "react-router": "^7.13.1",
        "react-syntax-highlighter": "^16.1.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1"
    },
    "engines": {
        "node": ">=22"
    }
}
