{
    "name": "@crab/rc-virtual",
    "description": "高效的虚拟滚动库，旨在提升大规模列表或内容渲染的性能。",
    "packageManager": "yarn@4.7.0",
    "version": "0.1.1",
    "type": "module",
    "scripts": {
        "start": "crustify dev",
        "build:library": "packify build",
        "test": "yarn node --experimental-vm-modules $(yarn bin jest)",
        "eslint": "eslint"
    },
    "files": [
        "esm",
        "cjs",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "devDependencies": {
        "@crab/crustify": "workspace:^",
        "@crab/packify": "workspace:^",
        "@crab/standards-eslint-preset": "workspace:^",
        "@crab/standards-jest-preset": "workspace:^",
        "@crab/standards-typescript-preset": "workspace:^",
        "@linaria/core": "^6.3.0",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.15.30",
        "@types/react": "^19.1.6",
        "@types/react-dom": "^19.1.6",
        "eslint": "^9.28.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^16.2.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "30.0.0-rc.1",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.33.1"
    },
    "dependencies": {
        "@crab/styleify": "workspace:^"
    },
    "engines": {
        "node": ">=22"
    }
}
