{
    "name": "@crab-dev/rc-virtual",
    "description": "高效的虚拟滚动库，旨在提升大规模列表或内容渲染的性能。",
    "packageManager": "yarn@4.18.0",
    "version": "0.1.4",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-virtual"
    },
    "type": "module",
    "scripts": {
        "start": "yarn generate:token && yarn generate:docgen && wake docs dev . --mode components",
        "build:library": "yarn generate:token && wake library build .",
        "generate:token": "wake library token .",
        "generate:docgen": "wake library docgen .",
        "test": "wake test --serial --coverage",
        "test:browser": "node scripts/prepare-browser-tests.mjs && yarn test --root src/__tests__/browser",
        "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
        "lint": "wake lint --format human --root ../.. components/rc-virtual/src components/rc-virtual/docs --env browser --max-warnings 0 && yarn lint:tools",
        "lint:tools": "wake lint --format human --root ../.. components/rc-virtual/scripts --env node --max-warnings 0",
        "check": "node ../../scripts/check-package.mjs"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./css/index.css": "./css/index.css",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@crab-dev/rc-auto-sizer": "workspace:^",
        "@crab-dev/rc-button": "workspace:^",
        "@crab-dev/rc-token-semantic": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.45",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router": "^8.3.1",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.45"
    },
    "crab": {
        "docsDependencies": [
            "@crab-dev/rc-auto-sizer",
            "@crab-dev/rc-button"
        ],
        "requiredChecks": [
            "test:browser"
        ]
    },
    "peerDependencies": {
        "react": "^19.2.0"
    }
}
