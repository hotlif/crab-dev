{
    "name": "@crab-dev/rc-virtual",
    "description": "高效的虚拟滚动库，旨在提升大规模列表或内容渲染的性能。",
    "packageManager": "yarn@4.7.0",
    "version": "0.1.1",
    "type": "module",
    "scripts": {
        "start": "crustify dev",
        "build:library": "packify build",
        "test": "yarn node --experimental-vm-modules $(yarn bin jest)",
        "eslint": "eslint"
    },
    "files": [
        "esm",
        "cjs",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "devDependencies": {
        "@crab-dev/crustify": "workspace:^",
        "@crab-dev/packify": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-jest-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@linaria/core": "^6.3.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.0.7",
        "@types/react": "^19.2.8",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.39.2",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.0.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "30.2.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.53.0"
    },
    "dependencies": {
        "@crab-dev/styleify": "workspace:^"
    },
    "engines": {
        "node": ">=22"
    }
}
