{
    "name": "@crab-dev/rc-color-picker",
    "description": "颜色选择组件",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "version": "0.0.4",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-color-picker"
    },
    "scripts": {
        "start": "yarn generate:token && yarn generate:docgen && wake docs dev . --mode components",
        "build:library": "yarn generate:token && wake library build .",
        "test": "wake test --serial --coverage",
        "test:browser": "yarn build:library && node scripts/prepare-browser-tests.mjs && yarn test --root src/__tests__/browser",
        "test:forced-colors": "yarn --cwd ../.. exec turbo run build:library --filter=@crab-dev/rc-color-picker && node scripts/prepare-browser-tests.mjs && node ../../scripts/test-published-forced-colors.mjs --package=. --fixture=src/__tests__/browser/forced-colors-fixture.tsx --api=__colorForced",
        "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "prettier:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "generate:docgen": "wake library docgen .",
        "generate:token": "wake library token .",
        "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
        "lint": "wake lint --format human --root ../.. components/rc-color-picker/src components/rc-color-picker/docs --env browser --max-warnings 0 && yarn lint:tools",
        "lint:tools": "wake lint --format human --root ../.. components/rc-color-picker/scripts --env node --max-warnings 0",
        "check": "node ../../scripts/check-package.mjs"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./css/index.css": "./css/index.css",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@crab-dev/rc-token-semantic": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.45",
        "@js-temporal/polyfill": "^0.5.1",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "prettier": "^3.9.6",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router": "^8.3.1",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.45",
        "@crab-dev/rc-button": "workspace:^",
        "@crab-dev/rc-config-provider": "workspace:^",
        "@crab-dev/rc-dropdown-container": "workspace:^",
        "@crab-dev/rc-hooks": "workspace:^",
        "@crab-dev/rc-line-edit": "workspace:^",
        "@crab-dev/rc-masonry": "workspace:^",
        "@crab-dev/rc-select": "workspace:^",
        "@crab-dev/rc-slider": "workspace:^"
    },
    "crab": {
        "docsDependencies": [],
        "requiredChecks": [
            "test:browser",
            "test:forced-colors"
        ]
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    }
}
