{
    "name": "@crab-dev/rc-form",
    "websiteConfig": {
        "title": "Form 表单",
        "category": "data-entry"
    },
    "description": "高性能的表单组件",
    "version": "0.0.7",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-form"
    },
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "scripts": {
        "start": "yarn generate:token && yarn generate:docgen && wake docs dev . --mode components",
        "build:library": "yarn generate:token && wake library build .",
        "generate:token": "wake library token .",
        "generate:docgen": "wake library docgen .",
        "check": "yarn tsc -p tsconfig.json --noEmit && yarn eslint && yarn test",
        "eslint": "eslint",
        "test": "wake test --serial --coverage",
        "typecheck": "tsc --noEmit"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./css/index.css": "./css/index.css",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@crab-dev/rc-button": "workspace:^",
        "@crab-dev/rc-checkbox": "workspace:^",
        "@crab-dev/rc-component-preview": "workspace:^",
        "@crab-dev/rc-line-edit": "workspace:^",
        "@crab-dev/rc-masonry": "workspace:^",
        "@crab-dev/rc-menu": "workspace:^",
        "@crab-dev/rc-radio": "workspace:^",
        "@crab-dev/rc-select": "workspace:^",
        "@crab-dev/rc-slider": "workspace:^",
        "@crab-dev/rc-switch": "workspace:^",
        "@crab-dev/rc-token-global": "workspace:^",
        "@crab-dev/rc-token-semantic": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.23",
        "@types/node": "^26.1.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.6.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.7.0",
        "lucide-react": "^1.23.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-markdown": "^10.1.0",
        "react-router": "^8.1.0",
        "react-syntax-highlighter": "^16.1.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.23",
        "@crab-dev/rc-spin": "workspace:^",
        "@crab-dev/rc-tooltip": "workspace:^"
    }
}
