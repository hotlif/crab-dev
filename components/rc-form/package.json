{
  "name": "@crab-dev/rc-form",
  "websiteConfig": {
    "title": "Form 表单",
    "category": "data-entry"
  },
  "description": "高性能的表单组件",
  "version": "0.0.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/hotlif/crab-dev.git",
    "directory": "components/rc-form"
  },
  "packageManager": "yarn@4.16.0",
  "type": "module",
  "scripts": {
    "start": "yarn generate:token && yarn generate:docgen && lignify run-task app:dev",
    "build:library": "yarn generate:token && packify build",
    "generate:token": "packify generate:css-token",
    "generate:docgen": "packify generate:docgen",
    "check": "yarn tsc -p tsconfig.json --noEmit && yarn eslint && yarn test",
    "eslint": "eslint",
    "test": "packify test",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "esm",
    "cjs",
    "css",
    "declarations"
  ],
  "types": "declarations/index.d.ts",
  "main": "cjs/index.cjs",
  "module": "esm/index.mjs",
  "devDependencies": {
    "@crab-dev/lignify": "workspace:^",
    "@crab-dev/packify": "workspace:^",
    "@crab-dev/rc-button": "workspace:^",
    "@crab-dev/rc-checkbox": "workspace:^",
    "@crab-dev/rc-component-preview": "workspace:^",
    "@crab-dev/rc-line-edit": "workspace:^",
    "@crab-dev/rc-masonry": "workspace:^",
    "@crab-dev/rc-menu": "workspace:^",
    "@crab-dev/rc-radio": "workspace:^",
    "@crab-dev/rc-select": "workspace:^",
    "@crab-dev/rc-slider": "workspace:^",
    "@crab-dev/rc-switch": "workspace:^",
    "@crab-dev/rc-token-global": "workspace:^",
    "@crab-dev/rc-token-semantic": "workspace:^",
    "@crab-dev/standards-eslint-preset": "workspace:^",
    "@crab-dev/standards-jest-preset": "workspace:^",
    "@crab-dev/standards-typescript-preset": "workspace:^",
    "@jest/globals": "30.4.1",
    "@linaria/core": "^8.0.0",
    "@mdx-js/react": "^3.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^8.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@crab-dev/rc-spin": "workspace:^",
    "@crab-dev/rc-tooltip": "workspace:^"
  }
}
