{
    "name": "@crab-dev/rc-form",
    "description": "高性能的表单组件",
    "version": "0.1.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-form"
    },
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "scripts": {
        "start": "yarn generate:token && yarn generate:docgen && wake docs dev . --mode components",
        "build:library": "yarn generate:token && wake library build .",
        "generate:token": "wake library token .",
        "generate:docgen": "wake library docgen .",
        "check": "node ../../scripts/check-package.mjs",
        "test": "wake test --serial --coverage",
        "test:browser": "yarn --cwd ../.. exec turbo run build:library --filter=@crab-dev/rc-form --filter=@crab-dev/rc-line-edit --filter=@crab-dev/rc-date-picker --filter=@crab-dev/rc-select --filter=@crab-dev/rc-theme && node scripts/prepare-browser-tests.mjs && yarn test --root src/__tests__/browser",
        "typecheck": "tsc --noEmit",
        "lint": "wake lint --format human --root ../.. components/rc-form/src components/rc-form/docs --env browser --max-warnings 0 && yarn lint:tools",
        "lint:tools": "wake lint --format human --root ../.. components/rc-form/scripts --env node --max-warnings 0",
        "build:visual": "wake docs build . --mode components --outdir .cache/visual-workbench",
        "test:visual": "node ../../scripts/visual/run.mjs --package ."
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./css/index.css": "./css/index.css",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@crab-dev/rc-button": "workspace:^",
        "@crab-dev/rc-checkbox": "workspace:^",
        "@crab-dev/rc-date-picker": "workspace:^",
        "@crab-dev/rc-line-edit": "workspace:^",
        "@crab-dev/rc-radio": "workspace:^",
        "@crab-dev/rc-select": "workspace:^",
        "@crab-dev/rc-slider": "workspace:^",
        "@crab-dev/rc-switch": "workspace:^",
        "@crab-dev/rc-theme": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.45",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-markdown": "^10.1.0",
        "react-router": "^8.3.1",
        "react-syntax-highlighter": "^16.1.1",
        "typescript": "6.0.2"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.45",
        "@crab-dev/rc-config-provider": "workspace:^",
        "@crab-dev/rc-spin": "workspace:^",
        "@crab-dev/rc-token-semantic": "workspace:^",
        "@crab-dev/rc-tooltip": "workspace:^",
        "lucide-react": "^1.43.0"
    },
    "crab": {
        "requiredChecks": [
            "test:browser"
        ],
        "docsDependencies": [
            "@crab-dev/rc-button",
            "@crab-dev/rc-checkbox",
            "@crab-dev/rc-line-edit",
            "@crab-dev/rc-radio",
            "@crab-dev/rc-select",
            "@crab-dev/rc-slider",
            "@crab-dev/rc-switch"
        ]
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    }
}
