{
    "name": "@crab-dev/rc-form",
    "description": "高性能的表单组件",
    "version": "0.0.6",
    "packageManager": "yarn@4.7.0",
    "type": "module",
    "scripts": {
        "start": "yarn generate:docgen && lignify run-task app:dev",
        "build:library": "packify build",
        "generate:docgen": "react-docgen ./src/form.tsx --out ./public/docgen.json",
        "eslint": "eslint",
        "test": "yarn node --experimental-vm-modules $(yarn bin jest)"
    },
    "files": [
        "esm",
        "cjs",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "devDependencies": {
        "@crab-dev/lignify": "workspace:^",
        "@crab-dev/packify": "workspace:^",
        "@crab-dev/rc-menu": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-jest-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@jest/globals": "30.3.0",
        "@linaria/core": "^7.0.0",
        "@mdx-js/react": "^3.1.1",
        "@react-docgen/cli": "^3.0.6",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^25.5.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.1.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.4.0",
        "jest": "^30.3.0",
        "jest-environment-jsdom": "30.3.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-icons": "^5.6.0",
        "react-markdown": "^10.1.0",
        "react-router": "^7.13.2",
        "react-syntax-highlighter": "^16.1.1",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.57.2"
    },
    "engines": {
        "node": ">=22"
    }
}
