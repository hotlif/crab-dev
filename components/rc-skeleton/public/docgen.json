{"./src/skeleton.tsx":[{"description":"骨架屏：在异步内容加载时提供占位节奏，降低用户感知等待时间。\r\n\r\n- `variant` 决定形状（text / rect / circle / button / avatar / image）\r\n- `animation` 决定动效（pulse 透明度脉动 / wave 渐变扫过）\r\n- `loading=false` 时渲染真实 `children`","methods":[],"displayName":"Skeleton","props":{"variant":{"required":false,"tsType":{"name":"union","raw":"\"text\" | \"rect\" | \"circle\" | \"button\" | \"avatar\" | \"image\"","elements":[{"name":"literal","value":"\"text\""},{"name":"literal","value":"\"rect\""},{"name":"literal","value":"\"circle\""},{"name":"literal","value":"\"button\""},{"name":"literal","value":"\"avatar\""},{"name":"literal","value":"\"image\""}]},"description":"骨架形状\r\n@default \"text\"","defaultValue":{"value":"\"text\"","computed":false}},"size":{"required":false,"tsType":{"name":"union","raw":"\"small\" | \"medium\" | \"large\"","elements":[{"name":"literal","value":"\"small\""},{"name":"literal","value":"\"medium\""},{"name":"literal","value":"\"large\""}]},"description":"尺寸阶梯（仅作用于 `text` 变体）\r\n@default \"medium\"","defaultValue":{"value":"\"medium\"","computed":false}},"width":{"required":false,"tsType":{"name":"union","raw":"number | string","elements":[{"name":"number"},{"name":"string"}]},"description":"显式宽度。数字按像素处理；字符串原样下发。"},"height":{"required":false,"tsType":{"name":"union","raw":"number | string","elements":[{"name":"number"},{"name":"string"}]},"description":"显式高度。数字按像素处理；字符串原样下发。"},"rows":{"required":false,"tsType":{"name":"number"},"description":"`text` 变体的行数；最后一行自动变短以模拟段落排版。\r\n@default 1","defaultValue":{"value":"1","computed":false}},"round":{"required":false,"tsType":{"name":"boolean"},"description":"是否强制圆角为 pill（常用于按钮 / 胶囊占位）\r\n@default false","defaultValue":{"value":"false","computed":false}},"active":{"required":false,"tsType":{"name":"boolean"},"description":"是否启用动画。关闭后骨架以静态背景展示。\r\n@default true","defaultValue":{"value":"true","computed":false}},"animation":{"required":false,"tsType":{"name":"union","raw":"\"pulse\" | \"wave\"","elements":[{"name":"literal","value":"\"pulse\""},{"name":"literal","value":"\"wave\""}]},"description":"动画形态\r\n@default \"pulse\"","defaultValue":{"value":"\"pulse\"","computed":false}},"loading":{"required":false,"tsType":{"name":"boolean"},"description":"是否处于加载态。为 `false` 时渲染 `children`。\r\n@default true","defaultValue":{"value":"true","computed":false}},"children":{"required":false,"tsType":{"name":"ReactNode"},"description":"加载完成后要渲染的真实内容"},"style":{"required":false,"tsType":{"name":"CSSProperties"},"description":"透传到容器根节点的内联样式（不推荐在组件层使用；仅在变量桥接时使用）"}},"composes":["Omit"]}]}