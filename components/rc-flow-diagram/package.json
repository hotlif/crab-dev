{
    "name": "@crab-dev/rc-flow-diagram",
    "websiteConfig": {
        "title": "FlowDiagram 流程图",
        "category": "data-display"
    },
    "description": "基于 rc-canvas 的流程图组件库，提供 Edge 连线、ELK 自动布局和正交边路由能力",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "version": "0.0.2",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-flow-diagram"
    },
    "scripts": {
        "start": "yarn generate:docgen && wake docs dev . --mode components",
        "build:library": "wake library build .",
        "generate:docgen": "wake library docgen .",
        "test": "wake test --serial --coverage",
        "eslint": "eslint .",
        "typecheck": "tsc --noEmit"
    },
    "files": [
        "esm",
        "cjs",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@crab-dev/rc-component-preview": "workspace:^",
        "@crab-dev/rc-masonry": "workspace:^",
        "@crab-dev/rc-menu": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.23",
        "@types/node": "^26.1.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.6.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.7.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router": "^8.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0"
    },
    "dependencies": {
        "@crab-dev/rc-canvas": "workspace:^",
        "elkjs": "^0.11.1"
    },
    "engines": {
        "node": ">=22"
    }
}
