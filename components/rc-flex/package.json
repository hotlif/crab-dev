{
    "name": "@crab-dev/rc-flex",
    "description": "Flex 弹性布局，支持子元素排版与长列表虚拟滚动",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "version": "0.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-flex"
    },
    "scripts": {
        "start": "yarn generate:docgen && wake docs dev . --mode components",
        "build:library": "wake library build .",
        "generate:docgen": "wake library docgen .",
        "test": "yarn --cwd ../.. exec turbo run build:library --filter=@crab-dev/rc-flex --filter=@crab-dev/rc-theme && node ../../scripts/prepare-published-css.mjs && wake test --serial --coverage",
        "typecheck": "node ../../scripts/typecheck.mjs",
        "lint": "wake lint --format human --root ../.. components/rc-flex/src components/rc-flex/docs --env browser --max-warnings 0",
        "check": "node ../../scripts/check-package.mjs"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./css/index.css": "./css/index.css",
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.57",
        "@crab-dev/rc-auto-sizer": "workspace:^",
        "@crab-dev/rc-virtual": "workspace:^"
    },
    "devDependencies": {
        "@crab-dev/rc-card": "workspace:^",
        "@crab-dev/rc-tag": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.57",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router": "^8.5.2",
        "typescript": "7.0.2"
    },
    "engines": {
        "node": ">=22"
    },
    "crab": {
        "docsDependencies": [
            "@crab-dev/rc-card",
            "@crab-dev/rc-tag"
        ]
    },
    "peerDependencies": {
        "react": "^19.2.0"
    }
}
