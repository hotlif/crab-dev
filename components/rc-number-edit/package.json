{
    "name": "@crab-dev/rc-number-edit",
    "description": "数字输入框, 支持步进、范围钳制、千分位与科学计数法自适应显示",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "version": "0.0.3",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-number-edit"
    },
    "scripts": {
        "start": "yarn generate:token && yarn generate:docgen && wake docs dev . --mode components",
        "build:library": "yarn generate:token && wake library build .",
        "prettier:write": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "prettier:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "generate:docgen": "wake library docgen .",
        "generate:token": "wake library token .",
        "test": "wake test --serial --coverage",
        "test:browser": "yarn --cwd ../.. exec turbo run build:library --filter=@crab-dev/rc-number-edit && node scripts/prepare-browser-tests.mjs && yarn test --root src/__tests__/browser",
        "check": "node ../../scripts/check-package.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "wake lint --format human --root ../.. components/rc-number-edit/src components/rc-number-edit/docs --env browser --max-warnings 0 && yarn lint:tools",
        "lint:tools": "wake lint --format human --root ../.. components/rc-number-edit/scripts --env node --max-warnings 0",
        "build:visual": "wake docs build . --mode components --outdir .cache/visual-workbench",
        "test:visual": "node ../../scripts/visual/run.mjs --package ."
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./css/index.css": "./css/index.css",
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.45",
        "@crab-dev/rc-button": "workspace:^",
        "@crab-dev/rc-config-provider": "workspace:^",
        "@crab-dev/rc-hooks": "workspace:^",
        "@crab-dev/rc-line-edit": "workspace:^",
        "lucide-react": "^1.43.0"
    },
    "devDependencies": {
        "@crab-dev/rc-theme": "workspace:^",
        "@crab-dev/rc-token-semantic": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.45",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "prettier": "^3.9.6",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router": "^8.3.1",
        "typescript": "6.0.2"
    },
    "engines": {
        "node": ">=22"
    },
    "crab": {
        "docsDependencies": [],
        "requiredChecks": [
            "test:browser"
        ]
    },
    "peerDependencies": {
        "react": "^19.2.0"
    }
}
