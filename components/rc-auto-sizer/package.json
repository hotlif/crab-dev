{
    "name": "@crab-dev/rc-auto-sizer",
    "websiteConfig": {
        "title": "AutoSizer 自适应容器",
        "category": "utility"
    },
    "description": "自动测量容器宽高并传入子渲染函数，常与虚拟滚动组件配合使用",
    "packageManager": "yarn@4.13.0",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "start": "yarn generate:docgen && lignify run-task app:dev",
        "build:library": "packify build",
        "generate:docgen": "packify generate:docgen",
        "test": "yarn node --experimental-vm-modules $(yarn bin jest)",
        "eslint": "eslint . ",
        "typecheck": "tsc --noEmit",
        "prepack": "cd ../.. && yarn build:library"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "dependencies": {
        "@crab-dev/rc-hooks": "workspace:^"
    },
    "devDependencies": {
        "@crab-dev/lignify": "workspace:^",
        "@crab-dev/packify": "workspace:^",
        "@crab-dev/rc-component-preview": "workspace:^",
        "@crab-dev/rc-masonry": "workspace:^",
        "@crab-dev/rc-menu": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-jest-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@jest/globals": "30.4.1",
        "@linaria/core": "^8.0.0",
        "@mdx-js/react": "^3.1.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.6.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.7.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "30.4.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router": "^8.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0"
    },
    "engines": {
        "node": ">=22"
    }
}
