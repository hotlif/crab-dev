{
    "name": "@crab-dev/rc-auto-sizer",
    "websiteConfig": {
        "title": "AutoSizer 自适应容器",
        "category": "utility"
    },
    "description": "自动测量容器宽高并传入子渲染函数，常与虚拟滚动组件配合使用",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "version": "0.0.2",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-auto-sizer"
    },
    "scripts": {
        "start": "yarn generate:docgen && wake docs dev . --mode components",
        "build:library": "wake library build .",
        "generate:docgen": "wake library docgen .",
        "test": "wake test --serial --coverage",
        "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
        "lint": "wake lint --format human --root ../.. components/rc-auto-sizer/src components/rc-auto-sizer/docs --env browser --max-warnings 0"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./css/index.css": "./css/index.css",
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.45",
        "@crab-dev/rc-hooks": "workspace:^"
    },
    "devDependencies": {
        "@crab-dev/rc-component-preview": "workspace:^",
        "@crab-dev/rc-masonry": "workspace:^",
        "@crab-dev/rc-menu": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.45",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router": "^8.3.1",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22"
    }
}
