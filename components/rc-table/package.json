{
    "name": "@crab-dev/rc-table",
    "websiteConfig": {
        "title": "Table 表格",
        "category": "data-display"
    },
    "description": "展示行列数据的表格组件",
    "packageManager": "yarn@4.16.0",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "start": "yarn generate:docgen && yarn generate:token && lignify run-task app:dev",
        "generate:docgen": "packify generate:docgen",
        "generate:token": "packify generate:css-token",
        "test": "yarn node --experimental-vm-modules $(yarn bin jest)",
        "build:library": "packify build",
        "eslint": "eslint",
        "prepack": "cd ../.. && yarn build:library",
        "typecheck": "tsc --noEmit"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "devDependencies": {
        "@crab-dev/lignify": "workspace:^",
        "@crab-dev/packify": "workspace:^",
        "@crab-dev/rc-component-preview": "workspace:^",
        "@crab-dev/rc-masonry": "workspace:^",
        "@crab-dev/rc-menu": "workspace:^",
        "@crab-dev/rc-token-semantic": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-jest-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@faker-js/faker": "^10.5.0",
        "@jest/globals": "30.4.1",
        "@linaria/core": "^8.0.0",
        "@mdx-js/react": "^3.1.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.6.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.7.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "30.4.1",
        "lucide-react": "^1.23.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0",
        "react-router": "^8.1.0",
        "react-syntax-highlighter": "^16.1.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0"
    },
    "dependencies": {
        "@crab-dev/rc-checkbox": "workspace:^",
        "@crab-dev/rc-empty": "workspace:^",
        "@crab-dev/rc-radio": "workspace:^",
        "@crab-dev/rc-virtual": "workspace:^",
        "jsonpath-plus": "^10.4.0"
    },
    "engines": {
        "node": ">=22"
    }
}
