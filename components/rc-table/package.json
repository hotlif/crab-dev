{
    "name": "@crab-dev/rc-table",
    "description": "展示行列数据的表格组件",
    "packageManager": "yarn@4.18.0",
    "version": "0.0.3",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-table"
    },
    "type": "module",
    "scripts": {
        "start": "yarn generate:token && yarn generate:docgen && wake docs dev . --mode components",
        "generate:docgen": "wake library docgen .",
        "generate:token": "wake library token .",
        "test": "wake test --serial --coverage",
        "test:selection": "yarn test src/__tests__/selectionVisibility.test.tsx --environment browser",
        "build:library": "yarn generate:token && wake library build .",
        "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
        "lint": "wake lint --format human --root ../.. components/rc-table/src components/rc-table/docs --env browser --max-warnings 0 && yarn lint:tools",
        "lint:tools": "wake lint --format human --root ../.. components/rc-table/scripts --env node --max-warnings 0",
        "test:browser": "yarn --cwd ../.. exec turbo run build:library --filter=@crab-dev/rc-table && node scripts/prepare-browser-tests.mjs && yarn test --root src/__tests__/browser",
        "check": "node ../../scripts/check-package.mjs",
        "test:forced-colors": "yarn --cwd ../.. exec turbo run build:library --filter=@crab-dev/rc-table && node ../../scripts/prepare-published-css.mjs && node ../../scripts/test-published-forced-colors.mjs --package=. --fixture=src/__tests__/browser/forced-colors-fixture.tsx --api=__tableForced"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./css/index.css": "./css/index.css",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@crab-dev/rc-auto-sizer": "workspace:^",
        "@crab-dev/rc-line-edit": "workspace:^",
        "@crab-dev/rc-number-edit": "workspace:^",
        "@crab-dev/rc-select": "workspace:^",
        "@crab-dev/rc-tag": "workspace:^",
        "@crab-dev/rc-text-edit": "workspace:^",
        "@crab-dev/rc-theme": "workspace:^",
        "@crab-dev/rc-token-semantic": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.45",
        "@faker-js/faker": "^10.6.0",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "lucide-react": "^1.43.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-markdown": "^10.1.0",
        "react-router": "^8.3.1",
        "react-syntax-highlighter": "^16.1.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.45",
        "@crab-dev/rc-button": "workspace:^",
        "@crab-dev/rc-checkbox": "workspace:^",
        "@crab-dev/rc-config-provider": "workspace:^",
        "@crab-dev/rc-empty": "workspace:^",
        "@crab-dev/rc-hooks": "workspace:^",
        "@crab-dev/rc-radio": "workspace:^",
        "@crab-dev/rc-virtual": "workspace:^",
        "jsonpath-plus": "^10.4.0"
    },
    "engines": {
        "node": ">=22"
    },
    "crab": {
        "docsDependencies": [
            "@crab-dev/rc-auto-sizer",
            "@crab-dev/rc-line-edit",
            "@crab-dev/rc-number-edit",
            "@crab-dev/rc-select",
            "@crab-dev/rc-tag",
            "@crab-dev/rc-text-edit"
        ],
        "requiredChecks": [
            "test:browser",
            "test:selection",
            "test:forced-colors"
        ]
    },
    "peerDependencies": {
        "react": "^19.2.0"
    }
}
