{
  "name": "@crab-dev/rc-token-semantic",
  "description": "一个全局的 token 管理组件",
  "packageManager": "yarn@4.13.0",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build:library": "packify build",
    "prettier:write": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prettier:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "generate:token": "packify generate:css-token",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "esm",
    "cjs",
    "declarations"
  ],
  "types": "declarations/index.d.ts",
  "main": "cjs/index.cjs",
  "module": "esm/index.mjs",
  "dependencies": {
    "@crab-dev/rc-token-global": "workspace:^"
  },
  "devDependencies": {
    "@crab-dev/packify": "workspace:^",
    "@crab-dev/standards-eslint-preset": "workspace:^",
    "@crab-dev/standards-jest-preset": "workspace:^",
    "@crab-dev/standards-typescript-preset": "workspace:^",
    "@jest/globals": "30.3.0",
    "@linaria/core": "^7.0.0",
    "@mdx-js/react": "^3.1.1",
    "@react-docgen/cli": "^3.0.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.1.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "lucide-react": "^1.7.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2"
  },
  "engines": {
    "node": ">=22"
  }
}
