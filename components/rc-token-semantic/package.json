{
    "name": "@crab-dev/rc-token-semantic",
    "websiteConfig": {
        "title": "TokenSemantic 语义令牌",
        "category": "primitive"
    },
    "description": "一个全局的 token 管理组件",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "version": "0.0.2",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-token-semantic"
    },
    "scripts": {
        "build:library": "yarn generate:token && wake library build .",
        "prettier:write": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "prettier:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "generate:token": "wake library token .",
        "typecheck": "tsc --noEmit",
        "start": "yarn generate:token && wake docs dev . --mode components"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.23",
        "@crab-dev/rc-token-global": "workspace:^"
    },
    "devDependencies": {
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.23",
        "@types/node": "^26.1.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.6.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.7.0",
        "lucide-react": "^1.23.0",
        "prettier": "^3.9.4",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router": "^8.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0"
    },
    "engines": {
        "node": ">=22"
    }
}
