{
    "name": "@crab-dev/rc-spin",
    "description": "加载中指示器, 用于表达耗时操作正在进行",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "version": "0.0.4",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-spin"
    },
    "scripts": {
        "start": "yarn generate:token && yarn generate:docgen && wake docs dev . --mode components",
        "build:library": "yarn generate:token && wake library build .",
        "prettier:write": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "prettier:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "generate:docgen": "wake library docgen .",
        "generate:token": "wake library token .",
        "test": "wake test --serial --coverage",
        "check": "node ../../scripts/check-package.mjs",
        "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
        "lint": "wake lint --format human --root ../.. components/rc-spin/src components/rc-spin/docs --env browser --max-warnings 0",
        "test:reduced-motion": "node scripts/test-reduced-motion-cli.mjs && yarn --cwd ../.. exec turbo run build:library --filter=@crab-dev/rc-spin --filter=@crab-dev/rc-theme && node ../../scripts/prepare-published-css.mjs && node ../../scripts/test-published-forced-colors.mjs --package=. --fixture=src/__tests__/browser/reduced-motion-fixture.tsx --api=__spinReducedMotion --colors=normal --motion=reduce"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./css/index.css": "./css/index.css",
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.45",
        "@crab-dev/rc-config-provider": "workspace:^",
        "@crab-dev/rc-hooks": "workspace:^"
    },
    "devDependencies": {
        "@crab-dev/rc-switch": "workspace:^",
        "@crab-dev/rc-token-semantic": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.45",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "prettier": "^3.9.6",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router": "^8.3.1",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22"
    },
    "crab": {
        "docsDependencies": [
            "@crab-dev/rc-switch"
        ],
        "requiredChecks": [
            "test:reduced-motion"
        ]
    },
    "peerDependencies": {
        "react": "^19.2.0"
    }
}
