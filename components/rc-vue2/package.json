{
    "name": "@crab/rc-vue2",
    "version": "0.0.2",
    "description": "将 React 组件转换成为 Vue2 可使用的组件",
    "packageManager": "yarn@4.7.0",
    "type": "module",
    "scripts": {
        "build:library": "packify build",
        "pack:tgz": "yarn pack --out .out/%s-%v.tgz",
        "eslint": "eslint"
    },
    "files": [
        "esm",
        "cjs",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "devDependencies": {
        "@crab/crustify": "workspace:^",
        "@crab/packify": "workspace:^",
        "@crab/standards-eslint-preset": "workspace:^",
        "@crab/standards-jest-preset": "workspace:^",
        "@crab/standards-typescript-preset": "workspace:^",
        "@jest/globals": "^29.7.0",
        "@linaria/core": "^6.3.0",
        "@types/node": "^22.13.10",
        "@types/react": "^19.0.11",
        "@types/react-dom": "^19.0.4",
        "eslint": "^9.22.0",
        "eslint-plugin-react": "^7.37.4",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.1"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "vue": "~2.7.16"
    },
    "engines": {
        "node": ">=22"
    }
}
