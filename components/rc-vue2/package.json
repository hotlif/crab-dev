{
    "name": "@crab/rc-vue2",
    "version": "0.0.1-canary",
    "description": "将 React 组件转换成为 Vue2 可使用的组件",
    "packageManager": "yarn@4.6.0",
    "type": "module",
    "scripts": {
        "build": "packify build",
        "test": "yarn node --experimental-vm-modules $(yarn bin jest)",
        "pack:tgz": "yarn pack --out .out/%s-%v.tgz",
        "eslint": "eslint"
    },
    "files": [
        "esm"
    ],
    "types": "esm/index.d.ts",
    "main": "esm/index.mjs",
    "module": "esm/index.mjs",
    "devDependencies": {
        "@crab/packify": "workspace:^",
        "@crab/standards-eslint-preset": "workspace:^",
        "@crab/standards-jest-preset": "workspace:^",
        "@crab/standards-typescript-preset": "workspace:^",
        "@jest/globals": "^29.7.0",
        "@linaria/core": "^6.2.0",
        "@types/node": "^22.10.7",
        "@types/react": "^19.0.7",
        "@types/react-dom": "^19.0.3",
        "eslint": "^9.18.0",
        "eslint-plugin-react": "^7.37.4",
        "globals": "^15.14.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "vue": "~2.7.16"
    }
}
