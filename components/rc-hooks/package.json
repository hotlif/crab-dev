{
    "name": "@crab-dev/rc-hooks",
    "websiteConfig": {
        "title": "Hooks 通用钩子",
        "category": "primitive"
    },
    "description": "复用状态、事件、尺寸测量和定时器等通用 React 逻辑",
    "version": "0.0.3",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-hooks"
    },
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "scripts": {
        "build:library": "wake library build .",
        "test": "wake test --serial --coverage",
        "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
        "start": "wake docs dev . --mode components",
        "lint": "wake lint --format human --root ../.. components/rc-hooks/src components/rc-hooks/docs --env browser --max-warnings 0"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.45",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22"
    }
}
