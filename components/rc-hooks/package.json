        "@linaria/core": "^6.3.0",
        "@types/node": "^22.15.30",
        "@types/react": "^19.1.6",
        "@types/react-dom": "^19.1.6",
        "eslint": "^9.28.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^16.2.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "30.0.0-rc.1",
        "react": "^19.1.0",
