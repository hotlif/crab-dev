{
    "name": "@crab-dev/rc-notification",
    "description": "消息通知组件",
    "packageManager": "yarn@4.13.0",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "start": "yarn generate:docgen && yarn generate:token && lignify run-task app:dev",
        "build:library": "packify build",
        "generate:docgen": "mkdir -p public && react-docgen ./src/notification.tsx --out ./public/docgen.json",
        "generate:token": "packify generate:css-token",
        "eslint": "eslint"
    },
    "files": [
        "esm",
        "cjs",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "devDependencies": {
        "@crab-dev/lignify": "workspace:^",
        "@crab-dev/packify": "workspace:^",
        "@crab-dev/rc-menu": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-jest-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@jest/globals": "30.3.0",
        "@linaria/core": "^7.0.0",
        "@mdx-js/react": "^3.1.1",
        "@react-docgen/cli": "^3.0.6",
        "@types/node": "^25.5.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.1.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.4.0",
        "jest": "^30.3.0",
        "jest-environment-jsdom": "30.3.0",
        "lucide-react": "^1.7.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-markdown": "^10.1.0",
        "react-router": "^7.13.2",
        "react-syntax-highlighter": "^16.1.1",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.57.2"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "motion": "^12.38.0"
    }
}
