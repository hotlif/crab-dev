{
    "name": "@crab-dev/rc-canvas",
    "websiteConfig": {
        "title": "Canvas WebGL 画布",
        "category": "data-display"
    },
    "description": "基于纯 WebGL 2 的 2D React 绘制组件库，提供 Canvas、Rect、Circle、Line、Image、Text、Group 等组件",
    "packageManager": "yarn@4.13.0",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "start": "yarn generate:docgen && lignify run-task app:dev",
        "generate:docgen": "node -e \"require('fs').mkdirSync('public',{recursive:true})\" && react-docgen ./src/canvas.tsx --out ./public/docgen.json",
        "build:library": "packify build",
        "test": "yarn node --experimental-vm-modules $(yarn bin jest)",
        "eslint": "eslint .",
        "typecheck": "tsc --noEmit",
        "prepack": "cd ../.. && yarn build:library"
    },
    "files": [
        "esm",
        "cjs",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "devDependencies": {
        "@crab-dev/lignify": "workspace:^",
        "@crab-dev/packify": "workspace:^",
        "@crab-dev/rc-component-preview": "workspace:^",
        "@crab-dev/rc-masonry": "workspace:^",
        "@crab-dev/rc-menu": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-jest-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@jest/globals": "30.4.1",
        "@linaria/core": "^8.0.0",
        "@mdx-js/react": "^3.1.1",
        "@react-docgen/cli": "^3.0.6",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.6.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.7.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "30.4.1",
        "react": "^19.2.7",
        "react-docgen": "^8.0.3",
        "react-dom": "^19.2.7",
        "react-router": "^8.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0"
    },
    "engines": {
        "node": ">=22"
    }
}
