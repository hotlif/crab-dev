{
  "name": "@crab-dev/rc-component-preview",
  "websiteConfig": {
    "title": "ComponentPreview 组件预览",
    "category": "primitive"
  },
  "description": "用于预览组件, 提供组件的预览和组件介绍说明",
  "packageManager": "yarn@4.13.0",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "start": "yarn generate:docgen && yarn generate:token && lignify run-task app:dev",
    "build:library": "packify build",
    "generate:docgen": "packify generate:docgen",
    "generate:token": "packify generate:css-token",
    "eslint": "eslint",
    "prepack": "cd ../.. && yarn build:library",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "esm",
    "cjs",
    "css",
    "declarations"
  ],
  "types": "declarations/index.d.ts",
  "main": "cjs/index.cjs",
  "module": "esm/index.mjs",
  "devDependencies": {
    "@crab-dev/lignify": "workspace:^",
    "@crab-dev/packify": "workspace:^",
    "@crab-dev/rc-masonry": "workspace:^",
    "@crab-dev/rc-menu": "workspace:^",
    "@crab-dev/standards-eslint-preset": "workspace:^",
    "@crab-dev/standards-jest-preset": "workspace:^",
    "@crab-dev/standards-typescript-preset": "workspace:^",
    "@jest/globals": "30.4.1",
    "@linaria/core": "^8.0.0",
    "@mdx-js/react": "^3.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "nx": {
    "targets": {
      "build:library": {
        "dependsOn": []
      }
    }
  }
}
