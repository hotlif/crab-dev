{"./src/lineChart.tsx":[{"description":"按类目顺序连接相邻有效数据点，支持图例筛选、指针与键盘交互。","methods":[],"displayName":"LineChart","props":{"aria-label":{"required":false,"tsType":{"name":"string"},"description":"无障碍数据表的标题。"},"categories":{"required":true,"tsType":{"name":"readonly string[]","raw":"readonly string[]"},"description":"横轴类目，依照传入的顺序等距排列。"},"className":{"required":false,"tsType":{"name":"string"},"description":""},"formatAxisValue":{"required":false,"tsType":{"name":"signature","raw":"(value: number) => string","type":"function"},"description":"单独格式化纵轴刻度，默认沿用 formatValue。"},"formatValue":{"required":false,"tsType":{"name":"signature","raw":"(value: number) => string","type":"function"},"description":"格式化提示、数据表和默认刻度值。"},"height":{"required":false,"tsType":{"name":"number"},"description":"画布高度（px），默认 320，图例高度另计。"},"labels":{"required":false,"tsType":{"name":"{ legend?: string; category?: string }","raw":"{ legend?: string; category?: string }"},"description":"覆盖图例名称和数据表的类目列表头。"},"onPointClick":{"required":false,"tsType":{"name":"signature","raw":"(info: PointClickInfo) => void","type":"function"},"description":"点击数据点或用键盘激活时触发。"},"palette":{"required":false,"tsType":{"name":"Partial<LineChartPalette>","raw":"Partial<LineChartPalette>"},"description":"对主题色板的局部覆盖。"},"ref":{"required":false,"tsType":{"name":"Ref<HTMLDivElement>","raw":"Ref<HTMLDivElement>"},"description":""},"referenceLines":{"required":false,"tsType":{"name":"readonly LineChartReferenceLine[]","raw":"readonly LineChartReferenceLine[]"},"description":"目标、阈值等水平参考线。"},"series":{"required":true,"tsType":{"name":"readonly LineChartSeries[]","raw":"readonly LineChartSeries[]"},"description":"最多绘制前八条系列，按原始系列顺序分配颜色。"},"style":{"required":false,"tsType":{"name":"CSSProperties"},"description":""},"width":{"required":false,"tsType":{"name":"union","raw":"number | 'auto'"},"description":"画布宽度（px），传 auto 跟随容器宽度，默认 600。"}}}]}