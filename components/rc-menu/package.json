{
    "name": "@crab-dev/rc-menu",
    "description": "为页面和功能提供导航的菜单列表。",
    "packageManager": "yarn@4.18.0",
    "version": "0.1.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-menu"
    },
    "type": "module",
    "scripts": {
        "start": "yarn generate:token && yarn generate:docgen && wake docs dev . --mode components",
        "build:library": "yarn generate:token && wake library build .",
        "test": "wake test --serial --coverage",
        "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "prettier:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "generate:docgen": "wake library docgen .",
        "generate:token": "wake library token .",
        "typecheck": "tsc --noEmit",
        "lint": "wake lint --format human --root ../.. components/rc-menu/src components/rc-menu/docs --env browser --max-warnings 0 && yarn lint:tools",
        "lint:tools": "wake lint --format human --root ../.. components/rc-menu/scripts --env node --max-warnings 0",
        "check": "node ../../scripts/check-package.mjs",
        "test:browser": "yarn --cwd ../.. exec turbo run build:library --filter=@crab-dev/rc-menu --filter=@crab-dev/rc-button && node scripts/prepare-browser-tests.mjs && yarn test --root src/__tests__/browser-behavior && yarn test --root src/__tests__/browser",
        "test:forced-colors": "yarn --cwd ../.. exec turbo run build:library --filter=@crab-dev/rc-menu && node scripts/prepare-browser-tests.mjs && node ../../scripts/test-published-forced-colors.mjs --package=. --fixture=src/__tests__/browser/forced-colors-fixture.tsx --api=__menuForced",
        "build:visual": "wake docs build . --mode components --outdir .cache/visual-workbench",
        "test:visual": "node ../../scripts/visual/run.mjs --package ."
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./css/index.css": "./css/index.css",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@crab-dev/rc-button": "workspace:^",
        "@crab-dev/rc-theme": "workspace:^",
        "@crab-dev/rc-token-semantic": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.45",
        "@types/node": "22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router": "^8.3.1",
        "typescript": "6.0.2"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.45",
        "@crab-dev/rc-config-provider": "workspace:^",
        "@crab-dev/rc-hooks": "workspace:^",
        "@floating-ui/react": "^0.27.20"
    },
    "engines": {
        "node": ">=22"
    },
    "crab": {
        "docsDependencies": [
            "@crab-dev/rc-button"
        ],
        "requiredChecks": [
            "test:browser",
            "test:forced-colors"
        ]
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    }
}
