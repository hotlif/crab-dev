{
    "name": "@crab-dev/rc-masonry",
    "description": "瀑布流布局组件，支持多列自适应排列",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "version": "0.0.2",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-masonry"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "start": "yarn generate:token && yarn generate:docgen && wake docs dev . --mode components",
        "build:library": "yarn generate:token && wake library build .",
        "generate:docgen": "wake library docgen .",
        "generate:token": "wake library token .",
        "test": "wake test --serial --coverage",
        "test:browser": "yarn --cwd ../.. exec turbo run build:library --filter=@crab-dev/rc-masonry && node scripts/prepare-browser-tests.mjs && yarn test --root src/__tests__/browser",
        "lint": "wake lint --format human --root ../.. components/rc-masonry/src components/rc-masonry/docs --env browser --max-warnings 0 && yarn lint:tools",
        "lint:tools": "wake lint --format human --root ../.. components/rc-masonry/scripts --env node --max-warnings 0",
        "check": "node ../../scripts/check-package.mjs",
        "build:visual": "wake docs build . --mode components --outdir .cache/visual-workbench",
        "test:visual": "node ../../scripts/visual/run.mjs --package ."
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./css/index.css": "./css/index.css",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@crab-dev/rc-checkbox": "workspace:^",
        "@crab-dev/rc-config-provider": "workspace:^",
        "@crab-dev/rc-select": "workspace:^",
        "@crab-dev/rc-theme": "workspace:^",
        "@crab-dev/rc-token-semantic": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.45",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router": "^8.3.1",
        "typescript": "6.0.2"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.45"
    },
    "crab": {
        "docsDependencies": [
            "@crab-dev/rc-checkbox",
            "@crab-dev/rc-select"
        ],
        "requiredChecks": [
            "test:browser"
        ]
    },
    "peerDependencies": {
        "react": "^19.2.0"
    }
}
