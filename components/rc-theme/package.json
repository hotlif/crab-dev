{
    "name": "@crab-dev/rc-theme",
    "websiteConfig": {
        "title": "Theme 主题样式",
        "category": "primitive"
    },
    "description": "Crab Design System 的 Light、Dark 与强制颜色主题",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "version": "0.0.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-theme"
    },
    "scripts": {
        "start": "wake docs dev . --mode components",
        "build:library": "wake library build .",
        "prettier:write": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "prettier:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
        "test": "wake test --serial --coverage",
        "check": "yarn lint && yarn prettier:check && yarn test",
        "lint": "wake lint --format human --root ../.. components/rc-theme/src components/rc-theme/docs --env browser --max-warnings 0"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "style": "css/index.css",
    "exports": {
        "./css/index.css": "./css/index.css",
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.38",
        "@crab-dev/rc-token-global": "workspace:^",
        "@crab-dev/rc-token-semantic": "workspace:^"
    },
    "devDependencies": {
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.43",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "prettier": "^3.9.6",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22"
    }
}
