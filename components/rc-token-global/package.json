{
    "name": "@crab-dev/rc-token-global",
    "websiteConfig": {
        "title": "TokenGlobal 全局令牌",
        "category": "primitive"
    },
    "description": "一个全局的 token 管理组件",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "version": "0.0.2",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "components/rc-token-global"
    },
    "scripts": {
        "build:library": "yarn generate:token && wake library build .",
        "prettier:write": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "prettier:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
        "generate:token": "wake library token .",
        "typecheck": "node ../../scripts/typecheck.mjs --noEmit",
        "start": "yarn generate:token && wake docs dev . --mode components",
        "lint": "wake lint --format human --root ../.. components/rc-token-global/src components/rc-token-global/docs --env browser --max-warnings 0"
    },
    "files": [
        "esm",
        "cjs",
        "css",
        "declarations"
    ],
    "types": "declarations/index.d.ts",
    "main": "cjs/index.cjs",
    "module": "esm/index.mjs",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.43",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "lucide-react": "^1.43.0",
        "prettier": "^3.9.6",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router": "^8.3.1",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@crab-dev/css": "0.1.38"
    }
}
