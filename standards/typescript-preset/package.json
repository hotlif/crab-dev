{
    "name": "@crab-dev/standards-typescript-preset",
    "version": "0.1.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "standards/typescript-preset"
    },
    "description": "用于 TypeScript 项目的 tsconfig 预设",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "scripts": {
        "test": "node ../../scripts/typecheck-fixtures.mjs && wake test --serial --coverage",
        "typecheck": "tsc --noEmit",
        "check": "node ../../scripts/check-package.mjs",
        "lint": "wake lint --format human --root ../.. standards/typescript-preset --env node --max-warnings 0"
    },
    "files": [
        "tsconfig.browser.react.json",
        "tsconfig.node.json"
    ],
    "devDependencies": {
        "@crab-dev/wake": "0.1.45",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "typescript": "6.0.2"
    },
    "engines": {
        "node": ">=22"
    }
}
