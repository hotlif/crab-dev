{
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "types": [
            "node"
        ],
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@@/*": [
                "./*"
            ]
        },
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "inlineSourceMap": false,
        "inlineSources": true
    }
}
