{
    "name": "@crab-dev/standards-eslint-preset",
    "packageManager": "yarn@4.18.0",
    "version": "0.0.3",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "standards/eslint-preset"
    },
    "description": "用于 ESLint 的配置预设，包含 React 和 TypeScript 的支持",
    "type": "module",
    "main": "index.mjs",
    "module": "index.mjs",
    "exports": {
        ".": "./index.mjs",
        "./package.json": "./package.json"
    },
    "peerDependencies": {
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.3",
        "globals": "^17.0.0"
    },
    "dependencies": {
        "@eslint/js": "9.39.5",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "eslint-plugin-import": "^2.32.0",
        "typescript": "6.0.2"
    },
    "devDependencies": {
        "@crab-dev/wake": "0.1.45",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.12.0",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "check": "node ../../scripts/check-package.mjs",
        "lint": "wake lint --format human --root ../.. standards/eslint-preset --env node --max-warnings 0"
    },
    "crab": {
        "status": "deprecated",
        "reason": "Historical ESLint preset compatibility; repository execution uses Wake Lint."
    }
}
