{
    "private": true,
    "version": "0.0.1",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "scripts": {
        "start": "yarn docs:dev",
        "build:library": "turbo run build:library --concurrency=2",
        "docs:dev": "yarn build:library && yarn workspace @crab-dev/website start",
        "docs:build": "yarn build:library && yarn workspace @crab-dev/website build",
        "test": "turbo run test --concurrency=2",
        "test:required": "node scripts/check-required.mjs",
        "test:browser:install": "node scripts/visual/install.mjs chromium",
        "test:visual": "node scripts/visual/run.mjs",
        "test:visual:inventory": "node scripts/visual/run.mjs inventory.visual.spec.mjs",
        "test:visual:candidate": "node scripts/visual/run.mjs --candidate",
        "test:visual:ui": "node scripts/visual/run.mjs --ui",
        "test:visual:report": "node scripts/visual/run.mjs report",
        "test:visual:install": "node scripts/visual/install.mjs",
        "test:visual:update": "node scripts/visual/run.mjs --update-snapshots=all",
        "test:visual:linux": "node scripts/visual/run-linux.mjs",
        "test:visual:build": "yarn docs:build && yarn test:visual",
        "lint": "yarn lint:tools && turbo run lint",
        "lint:tools": "wake lint --format human scripts test standards --env node --max-warnings 0 && yarn test:lint && yarn test:architecture && yarn test:ai-context",
        "ai:context": "node scripts/ai-context.mjs",
        "test:ai-context": "node --test scripts/ai-context.test.mjs",
        "typecheck": "turbo run typecheck",
        "generate:token": "turbo run generate:token",
        "check:tokens": "node ./scripts/check-token-contract.mjs",
        "changeset:version": "changeset version && yarn install --mode=update-lockfile && yarn install --immutable",
        "changeset:release": "node scripts/check-release.mjs && yarn build:library && yarn workspaces foreach --all --no-private --topological npm publish --tolerate-republish --access public && changeset tag",
        "prepare": "husky",
        "test:lint": "node scripts/lint-contract.test.mjs",
        "generate:architecture": "node scripts/generate-library-tasks.mjs",
        "generate:sdk": "sdks vscode",
        "check:architecture": "node scripts/check-library.mjs && node scripts/check-commands.mjs && node scripts/generate-library-tasks.mjs --check",
        "test:architecture": "node --test scripts/library-contract.test.mjs scripts/published-styles.test.mjs scripts/visual-contract.test.mjs",
        "check": "node scripts/check-repository.mjs",
        "check:commands": "node scripts/check-commands.mjs",
        "check:generated": "node scripts/check-generated.mjs",
        "check:generated:local": "node scripts/check-generated.mjs --regenerate",
        "check:exports": "node scripts/check-exports.mjs",
        "check:consumer": "node scripts/check-consumer.mjs"
    },
    "workspaces": [
        "standards/*",
        "components/*",
        ".website"
    ],
    "resolutions": {
        "@crab-dev/rc-button": "workspace:^",
        "@crab-dev/rc-checkbox": "workspace:^",
        "@crab-dev/rc-dialog": "workspace:^",
        "@crab-dev/rc-drawer": "workspace:^",
        "@crab-dev/rc-empty": "workspace:^",
        "@crab-dev/rc-line-edit": "workspace:^",
        "@crab-dev/rc-number-edit": "workspace:^",
        "@crab-dev/rc-segmented": "workspace:^",
        "@crab-dev/rc-switch": "workspace:^",
        "@crab-dev/rc-tag": "workspace:^",
        "@crab-dev/rc-text-edit": "workspace:^",
        "@yarnpkg/core": "4.9.1"
    },
    "dependenciesMeta": {
        "@playwright/test": {
            "unplugged": true
        },
        "playwright": {
            "unplugged": true
        },
        "playwright-core": {
            "unplugged": true
        }
    },
    "devDependencies": {
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "3.0.2",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.45",
        "@playwright/test": "1.64.1",
        "@types/node": "^26.6.5",
        "@yarnpkg/sdks": "3.3.1",
        "husky": "^9.1.7",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "turbo": "^2.10.12",
        "typescript": "6.0.2"
    }
}
