{
    "private": true,
    "version": "0.0.1",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "scripts": {
        "start": "yarn docs:dev",
        "build:library": "turbo run build:library",
        "docs:dev": "yarn build:library && yarn workspace @crab-dev/website start",
        "docs:build": "yarn build:library && yarn workspace @crab-dev/website build",
        "test": "turbo run test",
        "lint": "yarn lint:tools && turbo run lint",
        "lint:tools": "wake lint --format human scripts test standards --env node --max-warnings 0 && yarn test:lint",
        "typecheck": "node scripts/typecheck.mjs --prepare && turbo run typecheck",
        "typecheck:prepare": "node scripts/typecheck.mjs --prepare",
        "generate:token": "turbo run generate:token",
        "check:tokens": "node ./scripts/check-token-contract.mjs",
        "changeset:version": "changeset version && yarn install --mode=update-lockfile",
        "changeset:release": "yarn build:library && yarn workspaces foreach --all --no-private --topological npm publish --tolerate-republish --access public && changeset tag",
        "prepare": "husky",
        "test:lint": "node scripts/lint-contract.test.mjs"
    },
    "workspaces": [
        "standards/*",
        "components/*",
        ".website"
    ],
    "devDependencies": {
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "3.0.2",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.45",
        "@types/node": "^22.20.2",
        "husky": "^9.1.7",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "turbo": "^2.10.12",
        "typescript": "^7.0.2"
    }
}
