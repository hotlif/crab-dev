{
    "private": true,
    "version": "0.0.1",
    "packageManager": "yarn@4.13.0",
    "type": "module",
    "scripts": {
        "build:library": "yarn workspace @crab-dev/packify build:library && turbo run build:library",
        "test": "turbo run test",
        "lint": "turbo run eslint",
        "typecheck": "turbo run typecheck",
        "generate:token": "turbo run generate:token",
        "prepare": "husky"
    },
    "workspaces": [
        "standards/*",
        "toolbox/*",
        "components/*",
        "styleify"
    ],
    "devDependencies": {
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@crab-dev/rc-component-preview": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@linaria/core": "^7.0.0",
        "@types/node": "^25.5.0",
        "eslint": "^10.1.0",
        "husky": "^9.1.7",
        "turbo": "^2.5.4",
        "typescript": "^6.0.2"
    }
}
