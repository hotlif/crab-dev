    "toolbox/markify/__tests__/demo",
    "app/infinitum/crab-core-front"
  ],
  "devDependencies": {
    "@crab/standards-typescript-preset": "workspace:^",
    "@nx/eslint": "21.5.1",
    "@nx/jest": "21.5.1",
    "@nx/rollup": "21.5.1",
    "@nx/webpack": "21.5.1",
    "@types/node": "24.3.1",
    "nx": "21.5.1",
    "typescript": "^5.9.2"
  }
}
