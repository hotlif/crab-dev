{
    "private": true,
    "version": "0.0.1",
    "packageManager": "yarn@4.13.0",
    "type": "module",
    "scripts": {
        "start": "yarn workspace @crab-dev/website start",
        "build:library": "yarn workspace @crab-dev/packify build:library && turbo run build:library",
        "docs:dev": "yarn node ./toolbox/crustify/bin/cli.js run-task app:dev",
        "docs:build": "yarn node ./toolbox/crustify/bin/cli.js run-task app:build",
        "test": "turbo run test",
        "lint": "turbo run eslint",
        "typecheck": "turbo run typecheck",
        "generate:token": "turbo run generate:token",
        "prepack": "yarn gitsource:build",
        "prepare": "husky"
    },
    "workspaces": [
        "standards/*",
        "toolbox/*",
        "components/*",
        ".website"
    ],
    "devDependencies": {
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@crab-dev/crustify": "workspace:^",
        "@crab-dev/rc-component-preview": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@linaria/core": "^7.0.0",
        "@types/node": "^25.5.0",
        "eslint": "^10.1.0",
        "husky": "^9.1.7",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "turbo": "^2.5.4",
        "typescript": "^6.0.2"
    }
}
