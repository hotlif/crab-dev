{
  "name": "crab",
  "private": true,
  "version": "0.0.1",
  "packageManager": "yarn@4.7.0",
  "type": "module",
  "scripts": {
    "build": "nx run @crab/packify:build:library && nx run-many -t build:library",
    "test": "yarn dlx update-browserslist-db@latest && nx run-many -t run test"
  },
  "workspaces": [
    ".website",
