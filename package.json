{
    "private": true,
    "version": "0.0.1",
    "packageManager": "yarn@4.13.0",
    "type": "module",
    "scripts": {
        "build": "nx run @crab-dev/packify:build:library && nx run @crab-dev/rc-token-global:build:library && nx run @crab-dev/rc-token-semantic:build:library && nx run-many -t build:library",
        "test": "yarn dlx update-browserslist-db@latest && nx run-many -t run test",
        "eslint": "nx run-many -t run eslint",
        "generate:token": "nx run-many -t run generate:token"
    },
    "workspaces": [
        "standards/*",
        "toolbox/*",
        "components/*",
        "styleify"
    ],
    "devDependencies": {
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@nx/eslint": "22.6.3",
        "@nx/jest": "22.6.3",
        "@nx/rollup": "22.6.3",
        "@nx/webpack": "22.6.3",
        "@types/node": "25.5.0",
        "eslint": "^10.1.0",
        "nx": "22.6.3",
        "typescript": "^6.0.2"
    }
}
