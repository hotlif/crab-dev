{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build:library": {
            "dependsOn": ["^build:library"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!**/*.test.tsx",
                "!**/*.test.ts",
                "!src/__tests__/**/*",
                "!src/token.ts",
                "!docs/**/*",
                "!coverage/**/*",
                "!eslint.config.js"
            ],
            "outputs": ["esm/**", "cjs/**", "declarations/**", "css/**", "src/token.ts"]
        },
        "test": {
            "dependsOn": ["^build:library"],
            "inputs": ["$TURBO_DEFAULT$"],
            "outputs": ["coverage/**"]
        },
        "eslint": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "../../standards/eslint-preset/**/*"
            ],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": ["^build:library"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "../../standards/typescript-preset/**/*"
            ],
            "outputs": []
        },
        "generate:token": {
            "dependsOn": ["^generate:token"],
            "inputs": ["token.toml"],
            "outputs": ["src/token.ts"]
        },
        "generate:docgen": {
            "inputs": ["src/**/*", "tsconfig.json"],
            "outputs": ["public/docgen.json"]
        },
        "@crab-dev/rc-token-semantic#build:library": {
            "dependsOn": ["@crab-dev/rc-token-global#build:library"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!**/*.test.tsx",
                "!**/*.test.ts",
                "!src/__tests__/**/*",
                "!src/token.ts",
                "!docs/**/*",
                "!coverage/**/*",
                "!eslint.config.js"
            ],
            "outputs": ["esm/**", "cjs/**", "declarations/**", "css/**", "src/token.ts"]
        },
        "@crab-dev/rc-component-preview#generate:token": {
            "dependsOn": ["@crab-dev/rc-token-semantic#generate:token"],
            "inputs": ["token.toml"],
            "outputs": ["src/token.ts"]
        },
        "@crab-dev/rc-menu#generate:token": {
            "dependsOn": ["@crab-dev/rc-token-semantic#generate:token"],
            "inputs": ["token.toml"],
            "outputs": ["src/token.ts"]
        },
        "@crab-dev/rc-masonry#generate:token": {
            "dependsOn": ["@crab-dev/rc-token-semantic#generate:token"],
            "inputs": ["token.toml"],
            "outputs": ["src/token.ts"]
        },
        "@crab-dev/rc-spin#generate:token": {
            "dependsOn": ["@crab-dev/rc-token-semantic#generate:token"],
            "inputs": ["token.toml"],
            "outputs": ["src/token.ts"]
        },
        "@crab-dev/rc-button#generate:token": {
            "dependsOn": ["@crab-dev/rc-token-semantic#generate:token"],
            "inputs": ["token.toml"],
            "outputs": ["src/token.ts"]
        },
        "@crab-dev/rc-component-preview#build:library": {
            "dependsOn": ["@crab-dev/rc-token-semantic#build:library"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!**/*.test.tsx",
                "!**/*.test.ts",
                "!src/__tests__/**/*",
                "!src/token.ts",
                "!docs/**/*",
                "!coverage/**/*",
                "!eslint.config.js"
            ],
            "outputs": ["esm/**", "cjs/**", "declarations/**", "css/**", "src/token.ts"]
        },
        "@crab-dev/rc-menu#build:library": {
            "dependsOn": ["@crab-dev/rc-token-semantic#build:library"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!**/*.test.tsx",
                "!**/*.test.ts",
                "!src/__tests__/**/*",
                "!src/token.ts",
                "!docs/**/*",
                "!coverage/**/*",
                "!eslint.config.js"
            ],
            "outputs": ["esm/**", "cjs/**", "declarations/**", "css/**", "src/token.ts"]
        },
        "@crab-dev/rc-masonry#build:library": {
            "dependsOn": ["@crab-dev/rc-token-semantic#build:library"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!**/*.test.tsx",
                "!**/*.test.ts",
                "!src/__tests__/**/*",
                "!src/token.ts",
                "!docs/**/*",
                "!coverage/**/*",
                "!eslint.config.js"
            ],
            "outputs": ["esm/**", "cjs/**", "declarations/**", "css/**", "src/token.ts"]
        },
        "@crab-dev/rc-spin#build:library": {
            "dependsOn": [
                "@crab-dev/rc-hooks#build:library",
                "@crab-dev/rc-token-semantic#build:library"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!**/*.test.tsx",
                "!**/*.test.ts",
                "!src/__tests__/**/*",
                "!src/token.ts",
                "!docs/**/*",
                "!coverage/**/*",
                "!eslint.config.js"
            ],
            "outputs": ["esm/**", "cjs/**", "declarations/**", "css/**", "src/token.ts"]
        }
    }
}
