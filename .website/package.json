{
    "name": "@crab-dev/website",
    "private": true,
    "version": "0.0.1",
    "description": "crab-dev 官方 Wake Docs 组件文档站。",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "scripts": {
        "start": "yarn generate:docs && wake docs dev .",
        "build": "yarn generate:docs && wake docs build . --outdir docs-dist",
        "generate:docs": "node scripts/generate-component-docs.mjs",
        "check:docs": "node scripts/generate-component-docs.mjs --check",
        "test:generator": "node scripts/generate-component-docs.test.mjs",
        "eslint": "eslint docs scripts",
        "typecheck": "tsc --noEmit",
        "test": "yarn test:generator && yarn check:docs && wake test --serial"
    },
    "devDependencies": {
        "@crab-dev/css": "0.1.23",
        "@crab-dev/rc-component-preview": "workspace:^",
        "@crab-dev/rc-token-semantic": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.23",
        "@types/node": "^26.1.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.6.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.7.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0"
    },
    "engines": {
        "node": ">=22"
    }
}
