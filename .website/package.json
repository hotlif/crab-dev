{
    "name": "@crab-dev/website",
    "private": true,
    "version": "0.0.1",
    "description": "crab-dev 官方 Wake Docs 组件文档站。",
    "packageManager": "yarn@4.18.0",
    "type": "module",
    "scripts": {
        "start": "node scripts/docs-dev.mjs",
        "build": "yarn generate:docs && wake docs build . --outdir docs-dist && yarn check:build",
        "check:build": "node scripts/check-built-bindings.mjs",
        "test:build": "node scripts/check-built-bindings.test.mjs",
        "generate:docs": "node scripts/generate-component-docs.mjs",
        "check:docs": "node scripts/generate-component-docs.mjs --check",
        "test:generator": "node scripts/generate-component-docs.test.mjs",
        "typecheck": "node ../scripts/typecheck.mjs --noEmit",
        "test": "yarn test:generator && yarn check:docs && wake test --serial",
        "preview": "node scripts/preview-docs.mjs",
        "lint": "wake lint --format human --root .. .website/docs --env browser --max-warnings 0 && wake lint --format human --root .. .website/scripts --env browser --env node --max-warnings 0"
    },
    "devDependencies": {
        "@babel/generator": "^7.29.8",
        "@babel/parser": "^7.29.8",
        "@crab-dev/css": "0.1.38",
        "@crab-dev/rc-alert": "workspace:^",
        "@crab-dev/rc-app-main-layout": "workspace:^",
        "@crab-dev/rc-auto-sizer": "workspace:^",
        "@crab-dev/rc-avatar": "workspace:^",
        "@crab-dev/rc-badge": "workspace:^",
        "@crab-dev/rc-bar-chart": "workspace:^",
        "@crab-dev/rc-breadcrumbs": "workspace:^",
        "@crab-dev/rc-button": "workspace:^",
        "@crab-dev/rc-canvas": "workspace:^",
        "@crab-dev/rc-card": "workspace:^",
        "@crab-dev/rc-checkbox": "workspace:^",
        "@crab-dev/rc-color-picker": "workspace:^",
        "@crab-dev/rc-component-preview": "workspace:^",
        "@crab-dev/rc-cron-picker": "workspace:^",
        "@crab-dev/rc-date-picker": "workspace:^",
        "@crab-dev/rc-dialog": "workspace:^",
        "@crab-dev/rc-divider": "workspace:^",
        "@crab-dev/rc-drawer": "workspace:^",
        "@crab-dev/rc-dropdown-container": "workspace:^",
        "@crab-dev/rc-empty": "workspace:^",
        "@crab-dev/rc-flow-diagram": "workspace:^",
        "@crab-dev/rc-form": "workspace:^",
        "@crab-dev/rc-hooks": "workspace:^",
        "@crab-dev/rc-line-edit": "workspace:^",
        "@crab-dev/rc-masonry": "workspace:^",
        "@crab-dev/rc-menu": "workspace:^",
        "@crab-dev/rc-message": "workspace:^",
        "@crab-dev/rc-notification": "workspace:^",
        "@crab-dev/rc-number-edit": "workspace:^",
        "@crab-dev/rc-pagination": "workspace:^",
        "@crab-dev/rc-prose": "workspace:^",
        "@crab-dev/rc-radio": "workspace:^",
        "@crab-dev/rc-realm": "workspace:^",
        "@crab-dev/rc-router": "workspace:^",
        "@crab-dev/rc-segmented": "workspace:^",
        "@crab-dev/rc-select": "workspace:^",
        "@crab-dev/rc-skeleton": "workspace:^",
        "@crab-dev/rc-slider": "workspace:^",
        "@crab-dev/rc-spin": "workspace:^",
        "@crab-dev/rc-split-pane": "workspace:^",
        "@crab-dev/rc-switch": "workspace:^",
        "@crab-dev/rc-table": "workspace:^",
        "@crab-dev/rc-table-pro": "workspace:^",
        "@crab-dev/rc-tabs": "workspace:^",
        "@crab-dev/rc-tag": "workspace:^",
        "@crab-dev/rc-text-edit": "workspace:^",
        "@crab-dev/rc-theme": "workspace:^",
        "@crab-dev/rc-token-global": "workspace:^",
        "@crab-dev/rc-token-semantic": "workspace:^",
        "@crab-dev/rc-tooltip": "workspace:^",
        "@crab-dev/rc-tree": "workspace:^",
        "@crab-dev/rc-virtual": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@crab-dev/wake": "0.1.43",
        "@types/node": "^22.20.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "globals": "^17.12.0",
