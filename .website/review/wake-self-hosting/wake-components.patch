+.docs-nav-toggle[aria-expanded="true"] i { transform: rotate(90deg); }
+.docs-search-result { justify-content: start; text-align: start; white-space: normal; }
+.docs-search-result > span { display: grid; gap: var(--token-semantic-space-inline-gap); }
+.docs-search-result small { display: block; white-space: normal; }
+.docs-search-dialog { width: min(40rem, calc(100vw - 2rem)); }
+.docs-playground-dialog { width: min(70rem, calc(100vw - 2rem)); }
+.docs-back-to-top { position: fixed; z-index: 35; right: var(--token-semantic-space-group-gap); bottom: var(--token-semantic-space-group-gap); }
+@media (max-width: 760px) { .docs-search-trigger { min-width: 0; } .docs-search-trigger kbd { display: none; } }
