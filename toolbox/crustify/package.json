{
    "name": "@crab-dev/crustify",
    "description": "用来构建 React 开发的构建器, 预设了 babel 和 linaria 等一些配置",
    "packageManager": "yarn@4.16.0",
    "version": "0.0.19",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "toolbox/crustify"
    },
    "websiteConfig": {
        "title": "Crustify 开发构建器",
        "role": "Webpack 5",
        "stage": "开发",
        "summary": "起本地开发服务器。React Compiler、Linaria、SWC 与 MDX 开箱即用，存盘即热更新。",
        "output": "开发服务器与 HMR",
        "order": 1
    },
    "type": "module",
    "scripts": {
        "build:library": "packify build",
        "test": "packify test",
        "eslint": "eslint",
        "prepack": "cd ../.. && yarn build:library",
        "typecheck": "tsc --noEmit"
    },
    "files": [
        "bin",
        "esm",
        "cjs",
        "declarations",
        "template"
    ],
    "bin": "bin/cli.js",
    "types": "declarations/index.d.ts",
    "exports": {
        "types": "./declarations/index.d.ts",
        "import": "./esm/index.mjs",
        "require": "./cjs/index.cjs"
    },
    "devDependencies": {
        "@crab-dev/packify": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-jest-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@jest/globals": "30.4.1",
        "@types/babel__core": "^7.20.5",
        "@types/babel__preset-env": "^7.10.0",
        "@types/fs-extra": "^11.0.4",
        "@types/memory-fs": "^0.3.7",
        "@types/node": "^26.1.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.6.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.7.0",
        "jest": "^30.4.2",
        "memory-fs": "^0.5.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0"
    },
    "dependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-react": "^8.0.1",
        "@babel/preset-typescript": "^8.0.1",
        "@crab-dev/babel-plugin-auto-import-style": "workspace:^",
        "@mdx-js/loader": "^3.1.1",
        "@mdx-js/react": "^3.1.1",
        "@swc/core": "^1.15.43",
        "@wyw-in-js/webpack-loader": "^2.1.3",
        "babel-loader": "^10.1.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "buffer": "^6.0.3",
        "commander": "^15.0.0",
        "css-loader": "^7.1.4",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "eta": "^4.6.0",
        "fs-extra": "^11.3.6",
        "lightningcss": "^1.32.0",
        "lightningcss-loader": "^3.0.1",
        "mini-css-extract-plugin": "^2.10.2",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-stringify": "^11.0.0",
        "smol-toml": "^1.7.0",
        "string_decoder": "^1.3.0",
        "style-loader": "^4.0.0",
        "tapable": "^2.3.3",
        "terser-webpack-plugin": "^5.6.1",
        "thread-loader": "^4.0.4",
        "to-vfile": "^8.0.0",
        "ts-node": "^10.9.2",
        "unconfig": "^7.5.0",
        "unified": "^11.0.5",
        "webpack": "^5.108.4",
        "webpack-dev-server": "^6.0.0",
        "webpack-merge": "^6.0.1",
        "webpackbar": "^7.0.0",
        "yargs": "^18.0.0"
    },
    "peerDependencies": {
        "tapable": "^2.3.0"
    },
    "engines": {
        "node": ">=22"
    }
}
