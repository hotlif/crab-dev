        "@jest/globals": "^29.7.0",
        "@types/babel__core": "^7.20.5",
        "@types/babel__preset-env": "^7.10.0",
        "@types/fs-extra": "^11.0.4",
        "@types/memory-fs": "^0.3.7",
        "@types/node": "^22.13.9",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "eslint": "^9.21.0",
        "eslint-plugin-react": "^7.37.4",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "memory-fs": "^0.5.0",
        "typescript": "^5.8.2",
