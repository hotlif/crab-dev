{
    "name": "@crab/crustify",
    "description": "用来构建 React 开发的构建器, 预设了 babel 和 linaria 等一些配置",
    "packageManager": "yarn@4.6.0",
    "version": "0.0.1-canary",
    "type": "module",
    "scripts": {
        "build": "packify build",
