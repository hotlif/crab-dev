import { lazy } from "react";
<% it.sources.forEach(source => { %>
const <%=source.name%> = import("<%=source.path%>");
<% }) %>

<% it.entries.forEach(entry => { %>
const <%=entry.name%> = import("<%=entry.path%>");
<% }) %>

const components = [
    <% it.components.forEach((component, index) => { %>
    { name:"<%= component.name %>", component: <%= component.name %>, path: "<%= component.path %>", frontmatter: <%= component.frontmatter %>, source: <%= component.source %>}<% if (index < it.components.length - 1) { %>,<% } %>

    <% }) %>
];

export default components;