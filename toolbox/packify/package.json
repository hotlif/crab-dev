{
    "name": "@crab-dev/packify",
    "description": "用来构建依赖库的打包工具, 预设了 babel 和 linaria 等一些配置",
    "packageManager": "yarn@4.13.0",
    "version": "0.0.4",
    "type": "module",
    "scripts": {
        "build:library": "rollup -c",
        "test": "yarn node --experimental-vm-modules $(yarn bin jest)",
        "eslint": "eslint ."
    },
    "files": [
        "bin",
        "esm"
    ],
    "bin": "bin/cli.js",
    "devDependencies": {
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-jest-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@jest/globals": "30.3.0",
        "@types/babel__core": "^7.20.5",
        "@types/babel__preset-env": "^7.10.0",
        "@types/node": "^25.5.0",
        "eslint": "^10.1.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.4.0",
        "jest": "^30.3.0",
        "tslib": "^2.8.1",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.57.2"
    },
    "dependencies": {
        "@babel/core": "^7.29.0",
        "@babel/preset-env": "^7.29.2",
        "@babel/preset-react": "^7.28.5",
        "@babel/preset-typescript": "^7.28.5",
        "@rollup/plugin-babel": "^7.0.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@wyw-in-js/rollup": "^1.0.7",
        "babel-plugin-react-compiler": "^1.0.0",
        "rollup": "^4.60.0",
        "rollup-plugin-css-only": "^4.5.5",
        "rollup-plugin-dts": "^6.4.1",
        "smol-toml": "^1.6.1"
    },
    "engines": {
        "node": ">=22"
    }
}
