{
  "name": "@crab-dev/packify",
  "description": "用来构建依赖库的打包工具, 预设了 babel 和 linaria 等一些配置",
  "packageManager": "yarn@4.13.0",
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "build:library": "rollup -c",
    "test": "yarn node --experimental-vm-modules $(yarn bin jest)",
    "eslint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "bin",
    "esm"
  ],
  "bin": "bin/cli.js",
  "devDependencies": {
    "@crab-dev/standards-eslint-preset": "workspace:^",
    "@crab-dev/standards-jest-preset": "workspace:^",
    "@crab-dev/standards-typescript-preset": "workspace:^",
    "@jest/globals": "30.4.1",
    "@types/babel__core": "^7.20.5",
    "@types/babel__preset-env": "^7.10.0",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@wyw-in-js/rollup": "^2.1.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "rollup": "^4.62.2",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-dts": "^6.4.1",
    "smol-toml": "^1.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
