{
    "name": "@crab/packify",
    "description": "用来构建依赖库的打包工具, 预设了 babel 和 linaria 等一些配置",
    "packageManager": "yarn@4.6.0",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "eslint": "eslint"
    },
    "files": [
        "bin",
        "esm"
    ],
    "bin": "bin/cli.js",
    "devDependencies": {
        "@crab/standards-eslint-react-preset": "workspace:^",
        "@crab/standards-typescript-preset": "workspace:^",
        "@types/babel__core": "^7.20.5",
        "@types/babel__preset-env": "^7.9.7",
        "@types/node": "^22.10.2",
        "eslint": "^9.17.0",
        "eslint-plugin-react": "^7.37.3",
        "globals": "^15.14.0",
        "tslib": "^2.8.1",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.18.2"
    },
    "dependencies": {
        "@rollup/plugin-node-resolve": "^16.0.0",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.1.2",
        "@wyw-in-js/rollup": "^0.5.5",
        "rollup": "^4.29.1",
        "rollup-plugin-css-only": "^4.5.2"
    }
}
