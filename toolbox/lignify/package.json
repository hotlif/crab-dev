{
    "name": "@crab-dev/lignify",
    "version": "0.0.4",
    "repository": {
        "type": "git",
        "url": "https://github.com/hotlif/crab-dev.git",
        "directory": "toolbox/lignify"
    },
    "description": "使用此快速开发 React 组件库，可用来调试和生成 CSS 变量主题。",
    "packageManager": "yarn@4.16.0",
    "websiteConfig": {
        "title": "Lignify 文档环境",
        "role": "零配置",
        "stage": "文档",
        "summary": "零配置的文档与预览环境。自动扫描示例与 MDX，边写组件边调主题令牌。",
        "output": "文档站与在线预览",
        "order": 2
    },
    "type": "module",
    "scripts": {
        "start": "crustify run-task app:dev",
        "build": "crustify run-task app:build",
        "build:library": "packify build",
        "eslint": "eslint",
        "typecheck": "tsc --noEmit"
    },
    "files": [
        "bin",
        "esm",
        "cjs",
        "declarations",
        "template"
    ],
    "types": "declarations/index.d.ts",
    "bin": "bin/cli.js",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "import": "./esm/index.mjs",
            "require": "./cjs/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@crab-dev/packify": "workspace:^",
        "@crab-dev/rc-masonry": "workspace:^",
        "@crab-dev/rc-menu": "workspace:^",
        "@crab-dev/standards-eslint-preset": "workspace:^",
        "@crab-dev/standards-jest-preset": "workspace:^",
        "@crab-dev/standards-typescript-preset": "workspace:^",
        "@jest/globals": "30.4.1",
        "@linaria/core": "^8.0.0",
        "@mdx-js/react": "^3.1.1",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "26.1.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.6.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.7.0",
        "jest": "30.4.2",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router": "^8.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0",
        "webpack": "^5.108.4"
    },
    "peerDependencies": {
        "@crab-dev/rc-component-preview": "workspace:^",
        "@linaria/core": "^7.0.0",
        "@mdx-js/react": "^3.1.1",
        "react-router": "^7.12.0"
    },
    "dependencies": {
        "@crab-dev/crustify": "workspace:^",
        "@crab-dev/rc-component-preview": "workspace:^",
        "commander": "^15.0.0",
        "fs-extra": "^11.3.6"
    }
}
