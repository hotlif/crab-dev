{
    "name": "@crab/vue2-crustify-mod",
    "version": "0.0.1-canary",
    "description": "vue2 的模组, 用来支持 vue2 代码开发",
    "packageManager": "yarn@4.6.0",
    "type": "module",
    "scripts": {
        "build": "packify build",
        "pack:tgz": "yarn pack --out .out/%s-%v.tgz",
        "eslint": "eslint"
    },
    "files": [
        "esm"
    ],
    "bin": "bin/cli.js",
    "types": "esm/index.d.ts",
    "main": "esm/index.mjs",
    "module": "esm/index.mjs",
    "devDependencies": {
        "@crab/crustify": "workspace:^",
        "@crab/packify": "workspace:^",
        "@crab/standards-eslint-preset": "workspace:^",
        "@crab/standards-jest-preset": "workspace:^",
        "@crab/standards-typescript-preset": "workspace:^",
        "@jest/globals": "^29.7.0",
        "@types/node": "^22.13.9",
        "eslint": "^9.21.0",
        "eslint-plugin-react": "^7.37.4",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.0",
        "webpack": "^5.98.0"
    },
    "dependencies": {
        "vue-loader": "~15.11.1",
        "webpack-merge": "^6.0.1"
    }
}
